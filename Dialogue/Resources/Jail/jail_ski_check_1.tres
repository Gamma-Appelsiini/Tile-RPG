line_text = "Using your skill of snatching keys, adeptly grab the keys from the old man's waist."
fail_text = "You extend your hand, but your fingers brush too clumsily against the key. The old man jolts and keeps a tighter hold of the key now."
pass_text = "With steady hands and sharp precision, you ease the keyring free from his belt. The old man continues his rambling, completely unaware as you slide the key back into your cell."
